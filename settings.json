{
  "theme": "dark",
  "lastChangelogVersion": "1.4.0",
  "enabledModels": ["openrouter/openrouter/free", "openai-codex/gpt-6-luna"],
  "defaultModel": "openrouter/free",
  "defaultProvider": "openrouter",
  "defaultThinkingLevel": "high",
  "tuiMode": "regular",
  "fullscreenExitOutput": "transcript",
  "packages": [
    "npm:pi-open-tui",
    "npm:pi-web-access",
    "npm:pi-lens",
    "npm:pi-memory",
    "npm:pi-droid",
    "npm:billion-context",
    "npm:pi-subagents",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-background-tasks@latest"
  ],
  "subagents": {
    "defaultModel": "openai-codex/gpt-6-luna",
    "defaultProvider": "openai-codex",
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": ["openai-codex/gpt-6-luna"]
    }
  },
  "externalEditor": "nvim",
  "hideThinkingBlock": false
}
